{
  "name": "thrones-of-heaven",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Thrones of Heaven — Washington State map prototype",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "smoke": "esbuild src/world/world-smoke.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/toh-smoke.mjs --log-level=warning && node node_modules/.cache/toh-smoke.mjs",
    "verify:runtime": "node tools/verify-runtime.mjs",
    "verify": "npm run build && npm run smoke && npm run verify:runtime",
    "gen:sprites": "node scripts/gen-sprites.mjs",
    "bake:earth": "node scripts/bake-earth/bake.mjs",
    "bake:worldmap": "node scripts/bake-earth/worldmap.mjs",
    "bake:regionmaps": "node scripts/bake-earth/regionmap.mjs",
    "lint:terrain-art": "node tools/lint-terrain-art.mjs",
    "convert:terrain": "node tools/convert-terrain-art.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.0"
  },
  "devDependencies": {
    "playwright-core": "1.62.0",
    "pngjs": "7.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
