{
  "name": "airhorn-hero",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Airhorn Hero — a tap-to-blast airhorn soundboard game for Android & iOS (PWA + Capacitor).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "node tools/make-icons.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0"
  }
}
